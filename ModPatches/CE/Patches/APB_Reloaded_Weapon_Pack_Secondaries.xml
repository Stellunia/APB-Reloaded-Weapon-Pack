<?xml version="1.0" encoding="utf-8"?>
<Patch>
				
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>APB_Reloaded_Kokoe</defName>
        <statBases>
            <RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
            <SightsEfficiency>0.85</SightsEfficiency>
            <ShotSpread>0.25</ShotSpread>
            <SwayFactor>0.70</SwayFactor>
            <Mass>1.05</Mass>
			<Bulk>2.05</Bulk>
			<WorkToMake>12000</WorkToMake>
        </statBases>

        <costList>
            <Chemfuel>5</Chemfuel>
            <Steel>20</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>

        <Properties>
            <recoilAmount>2.5</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
            <defaultProjectile>Bullet_45ACP_FMJ</defaultProjectile>
            <warmupTime>0.7</warmupTime>
            <range>25</range>
            <soundCast>APB_Kokoe_Shot</soundCast>
            <soundCastTail>APB_Kokoe_Tail</soundCastTail>
            <muzzleFlashScale>9</muzzleFlashScale>
        </Properties>

        <AmmoUser>
            <magazineSize>10</magazineSize>
            <reloadTime>1.4</reloadTime>
            <ammoSet>AmmoSet_45ACP</ammoSet>
			<reloadOneAtATime>False</reloadOneAtATime>
        </AmmoUser>

        <FireModes>
            <aiUseBurstMode>FALSE</aiUseBurstMode>
			<noSingleShot>false</noSingleShot>
			<noSnapshot>false</noSnapshot>
        </FireModes>

        <weaponTags>
			<li>CE_Sidearm</li>
			<li>CE_AI_Pistol</li>
            <li>CE_OneHandedWeapon</li>
        </weaponTags>
		<researchPrerequisite>GasOperation</researchPrerequisite>
		<AllowWithRunAndGun>true</AllowWithRunAndGun>
    </Operation>


	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>APB_Reloaded_ACT</defName>
		<statBases>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
