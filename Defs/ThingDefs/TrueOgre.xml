<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>APB_Reloaded_NFAS_TrueOgre</defName>
    <label>NFAS True Ogre</label>
	<description>The Nekrova Fully Automatic Shotgun is a weapon that excels when engaging multiple hostiles in Close Quarters. When fired fully automatic it can empty its 7 round drum in less than a second, though representatives from Nekrova International recommend against this due to the weapon's relatively long reload time. Dual Drum magazines and a cosmetic extra barrel give the NFAS-12 'True Ogre' an imposing look while also effectively doubling the ammo capacity and magazine size of this already intimidating weapon.</description>
    <graphicData>
      <texPath>Things/NFASTrueOgre</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.1</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>ShortShots</li>
    </weaponClasses>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>						   			
	<recipeMaker>
      <researchPrerequisite>GasOperation</researchPrerequisite>
      <skillRequirements>
        <Crafting>16</Crafting>
      </skillRequirements>
      <displayPriority>750</displayPriority>
    </recipeMaker>
	<costList>
		<Steel>100</Steel>
		<ComponentIndustrial>5</ComponentIndustrial>
	</costList>
	<statBases>
		<WorkToMake>15500</WorkToMake>
		<MarketValue>1800</MarketValue>								 
		<Mass>10.3</Mass>
		<AccuracyTouch>0.90</AccuracyTouch>
		<AccuracyShort>0.65</AccuracyShort>
		<AccuracyMedium>0.30</AccuracyMedium>
		<AccuracyLong>0.25</AccuracyLong>
		<RangedWeapon_Cooldown>5.0</RangedWeapon_Cooldown>
	</statBases>
	<equippedStatOffsets>
	</equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Pellets_TrueOgre</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>22</range>
        <burstShotCount>10</burstShotCount>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <soundCast>APB_TrueOgre_Shot</soundCast>
        <soundCastTail>APB_TrueOgre_Tail</soundCastTail>
		<soundAiming>APB_TrueOgre_Winding</soundAiming>
        <muzzleFlashScale>15</muzzleFlashScale>
      </li>
    </verbs>
	<weaponTags>
      <li>IndustrialGunAdvanced</li>
      <li>ShortShots</li>
    </weaponTags>
	<tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2.0</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2.0</cooldownTime>
      </li>
    </tools>
      <modExtensions>
          <li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
              <def>MF_StandardMuzzleFalsh</def>
              <drawSize>(1,1.5)</drawSize>
              <offsets>
                  <li>(0.51,0.03)</li>
              </offsets>
          </li>
      </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>Pellets_TrueOgre</defName>
    <label>true ogre pellets</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Shotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <stoppingPower>3</stoppingPower>
      <speed>70</speed>
    </projectile>
  </ThingDef>
  
</Defs>