			<volumeRange>18~20</volumeRange>
			<pitchRange>0.9082352~1.091765</pitchRange>
		</li>
	</subSounds>
	</SoundDef>
	
	<SoundDef>
	<defName>APB_TrueOgre_Winding</defName>
    <context>MapOnly</context>
    <sustain>true</sustain>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustainStartSound>APB_TrueOgre_Windup</sustainStartSound>
	<sustainStopSound>APB_TrueOgre_WindDown</sustainStopSound>
	<subSounds>
		<li>
	        <muteWhenPaused>true</muteWhenPaused>
			<grains>
				<li Class="AudioGrain_Clip">
					<clipPath>Weapons/TrueOgre/TrueOgre_Windup</clipPath>
				</li>
			</grains>
			<volumeRange>15~20</volumeRange>
			<pitchRange>1~1</pitchRange>
		</li>
	</subSounds>
	</SoundDef>
	
	<SoundDef>
    <defName>APB_TrueOgre_Windup</defName>
    <context>MapOnly</context>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Weapons/TrueOgre/TrueOgre_Windup</clipPath>
          </li>
        </grains>
