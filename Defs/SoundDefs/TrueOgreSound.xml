		<pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>
	
	<SoundDef>
	<defName>APB_TrueOgre_WindDown</defName>
	<context>MapOnly</context>
	<subSounds>
		<li>
			<grains>
				<li Class="AudioGrain_Clip">
					<clipPath>Weapons/OSMAW/OSMAW_WindDown</clipPath>
