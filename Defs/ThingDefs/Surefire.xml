<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>APB_Reloaded_ALIG_Surefire</defName>
    <label>ALIG Surefire</label>
	<description>Designed by Agrotech as part of their range of anti-vehicle weaponry.</description>
    <graphicData>
      <texPath>Things/ALIGSurefire</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.3</drawSize>						   
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
	<recipeMaker>
      <researchPrerequisite>GasOperation</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>750</displayPriority>
    </recipeMaker>
	<costList>
		<Steel>120</Steel>
		<ComponentIndustrial>3</ComponentIndustrial>
	</costList>
	<statBases>
		<WorkToMake>13250</WorkToMake>
		<MarketValue>900</MarketValue>
		<Mass>12.3</Mass>
		<AccuracyTouch>0.35</AccuracyTouch>
		<AccuracyShort>0.55</AccuracyShort>
		<AccuracyMedium>0.70</AccuracyMedium>
		<AccuracyLong>0.35</AccuracyLong>
		<RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
	</statBases>
	<equippedStatOffsets>
		<MoveSpeed>-0.20</MoveSpeed>
	</equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ALIG</defaultProjectile>
        <warmupTime>2.4</warmupTime>
        <range>34</range>
        <burstShotCount>10</burstShotCount>
        <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
        <soundCast>APB_ALIG_Shot</soundCast>
        <soundCastTail>APB_ALIG_Tail</soundCastTail>
        <muzzleFlashScale>20</muzzleFlashScale>
      </li>
    </verbs>
	<weaponTags>
      <li>IndustrialGunAdvanced</li>
      <li>ShortShots</li>
	  <li>GunHeavy</li>
    </weaponTags>
						   		   
	<tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>3.5</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>2</power>
        <cooldownTime>3.5</cooldownTime>
      </li>
    </tools>
      <modExtensions>
          <li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
              <def>MF_StandardMuzzleFalshThree</def>
              <drawSize>(1,1)</drawSize>
              <offsets>
                  <li>(0.69,0.02)</li>
              </offsets>
          </li>
      </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_ALIG</defName>
    <label>ALIG bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>19</damageAmountBase>
      <armorPenetrationBase>0.20</armorPenetrationBase>
      <stoppingPower>2</stoppingPower>
      <speed>45</speed>
    </projectile>
  </ThingDef>
  
</Defs>